node_modules/
coverage/
*.log

# dist/ is not ignored: it is the bundle Claude Code runs, committed (see .gitattributes).

# Only the plugin's own skill is published; anything else under skills/ is a person's own.
skills/*
!skills/tag/

# Environment: a key never belongs in the repository.
.env
.env.*

# A person's own agent settings; `.claude-plugin/` is the published manifest.
.agents/
.claude/
.gemini/

# Editor and OS
.vscode/
.idea/
.DS_Store
